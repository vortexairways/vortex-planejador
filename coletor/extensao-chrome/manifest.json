{
  "manifest_version": 3,
  "name": "Coletor local da Vortex",
  "description": "Lê a frota, os hangares, os hubs, as rotas, os pilotos e os voos da Vortex na sessão do PilOps.",
  "version": "1.5.0",
  "background": {
    "service_worker": "coletor.js"
  },
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://pilops.com/*",
    "http://127.0.0.1:8768/*"
  ],
  "action": {
    "default_title": "Estado do coletor local da Vortex"
  },
  "key": ""
}
