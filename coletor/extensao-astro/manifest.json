{
  "manifest_version": 3,
  "name": "Vortex · Dono",
  "description": "Botão do dono no planejador da Vortex: lê a companhia no PilOps (frota, pilotos, voos e vagas com carga e passageiros) e publica a parte pública no planejador.",
  "version": "2.0.0",
  "background": {
    "service_worker": "servico.js",
    "type": "module"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pilops.com/*",
    "https://api.github.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://vortexairways.github.io/*"
    ]
  },
  "options_page": "opcoes.html",
  "action": {
    "default_title": "Vortex · Dono"
  },
  "key": ""
}
