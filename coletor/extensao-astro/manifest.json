{
  "manifest_version": 3,
  "name": "Vortex · Vagas",
  "description": "Lê a aba Vagas da Vortex no PilOps (carga e passageiros, que só o dono vê) e publica no planejador.",
  "version": "1.0.0",
  "background": {
    "service_worker": "servico.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pilops.com/*",
    "https://api.github.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://vortexairways.github.io/*"
    ]
  },
  "options_page": "opcoes.html",
  "action": {
    "default_title": "Vortex · Vagas"
  },
  "key": ""
}
