{
  "manifest_version": 3,
  "name": "Vortex · Carga",
  "description": "Botão Encher no PilOps do planejador da Vortex: escolhe as ofertas que rendem mais para o destino da rota e as coloca no voo aberto no PilOps, sem tirar o que já está a bordo.",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "background": {
    "service_worker": "servico.js"
  },
  "host_permissions": [
    "https://pilops.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pilops.com/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pilops.com/*"
      ],
      "js": [
        "cargas.js",
        "enchimento.js",
        "ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://vortexairways.github.io/*"
    ]
  },
  "action": {
    "default_title": "Vortex · Carga"
  },
  "key": ""
}
